generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  email          String        @unique
  name           String?
  avatar         String?
  provider       String        @default("email")
  providerId     String?
  profile        Json
  preferences    Json
  linkedinToken  String?
  naukriEmail    String?
  naukriPassword String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
}

model Job {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  source       String
  externalId   String
  title        String
  company      String
  location     String
  url          String
  description  String
  requirements String?
  salary       String?
  jobType      String?
  experience   String?
  postedAt     DateTime
  rawData      Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@unique([source, externalId])
}

model Application {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  jobId       String    @db.ObjectId
  status      String    @default("pending")
  resumeUsed  String
  coverLetter String?
  appliedAt   DateTime?
  response    Json?
  error       String?
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model ScrapingLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  source    String
  status    String
  jobsFound Int
  jobsNew   Int
  error     String?
  duration  Int
  createdAt DateTime @default(now())
}

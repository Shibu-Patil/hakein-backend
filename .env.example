# Copy to .env and fill values
# Database (MongoDB Atlas) - paste your Atlas URL here
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hakein?retryWrites=true&w=majority"

# Redis - local or Redis Cloud (required only for queue/worker/scheduler)
REDIS_URL="redis://localhost:6379"

PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

ENCRYPTION_KEY="your-32-char-encryption-key-here"

# Job automation
SCRAPING_CRON="0 */2 * * *"
AUTO_APPLY_LIVE=false
PLAYWRIGHT_HEADLESS=true
LINKEDIN_LI_AT=""

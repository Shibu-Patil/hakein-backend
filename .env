# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hakein?retryWrites=true&w=majority"

# Redis (for BullMQ) - use local or Redis Cloud
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# AI Providers (fallback keys, users can override per request)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Encryption for stored credentials
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# Scraping
SCRAPING_INTERVAL_HOURS=2
MAX_JOBS_PER_RUN=50
PLAYWRIGHT_HEADLESS=true

# LinkedIn (optional - for official API)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Naukri
NAUKRI_LOGIN_URL="https://www.naukri.com/nlogin/login"
NAUKRI_JOBS_API="https://www.naukri.com/jobapi/v3/search"